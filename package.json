{
  "name": "harness-leca",
  "private": true,
  "description": "Projetos estilo Claude Chat sobre Claude Code, Gemini/Antigravity e opencode. Backend e tools sem dependências de runtime; UI nova em ilhas React (ADR-011).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sync": "node tools/sync.js",
    "sync:dry": "node tools/sync.js --dry-run",
    "adopt": "node tools/adopt-project.js",
    "export:context": "node tools/export-context.js",
    "export:claude-sessions": "node tools/export-claude-sessions.js",
    "coordination": "node tools/coordination.js",
    "hia": "node tools/hia.js",
    "ui": "node ui/server.js",
    "ui:dev": "node --watch-path=ui/server --watch-path=ui/server.js --watch-path=tools/lib --watch-path=tools/ds-docs --watch-preserve-output ui/server.js",
    "ui:dev:remote": "node --watch-path=ui/server --watch-path=ui/server.js --watch-path=tools/lib --watch-path=tools/ds-docs --watch-preserve-output ui/server.js --remote",
    "build:web": "vite build --config ui/web/vite.config.ts",
    "dev:web": "vite build --config ui/web/vite.config.ts --watch",
    "types:web": "tsc -p ui/web && tsc -p ui/web/tsconfig.node.json",
    "lint:web": "biome check ui/web",
    "lint:proto": "node tools/atelier-pilot/lint-prototype.js",
    "visual:proto": "node tools/atelier-pilot/visual-compare.js",
    "e2e:web": "node scripts/e2e-island-lab.js",
    "remote": "node ui/server.js --remote",
    "remote:tunnel": "node tools/tunnel.js",
    "opencode": "node tools/start-opencode.js",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/*.test.js\"",
    "regressao": "node scripts/regressao.js",
    "types": "node scripts/types.js",
    "types:baseline": "node tools/types-baseline.js",
    "types:baseline:update": "node tools/types-baseline.js --update",
    "setup:hooks": "git config core.hooksPath .githooks",
    "routines": "node tools/run-scheduled.js",
    "routines:list": "node tools/run-scheduled.js --list",
    "schedule:windows": "node tools/schedule-windows.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@xyflow/react": "^12.12.1",
    "d3-hierarchy": "^3.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.18.11"
  }
}
