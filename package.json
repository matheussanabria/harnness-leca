{
  "name": "harness-leca",
  "private": true,
  "description": "Projetos estilo Claude Chat sobre Claude Code, Gemini/Antigravity e opencode. Sem dependências.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sync": "node tools/sync.js",
    "sync:dry": "node tools/sync.js --dry-run",
    "ui": "node ui/server.js",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/*.test.js\"",
    "types": "node scripts/types.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "routines": "node tools/run-scheduled.js",
    "routines:list": "node tools/run-scheduled.js --list",
    "schedule:windows": "node tools/schedule-windows.js"
  }
}
