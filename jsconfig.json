{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["tools/**/*.js", "tools/**/*.d.ts", "ui/server.js", "scripts/*.js"],
  "exclude": ["node_modules", "projects", "tests"]
}
