# Fins de linha: o repositório guarda LF; os esperados do golden master não podem ser convertidos.
*.md text eol=lf
tests/golden/** -text
.githooks/* text eol=lf
*.sh text eol=lf
# Runtime vendorizado do Claude Design: os bytes precisam bater com os hashes aceitos (sem conversao de fim de linha).
ui/public/js/vendor/dc-runtime/** -text
# React islands (ADR-011): Biome expects LF, so island code and its config never convert to CRLF.
ui/web/** text eol=lf
biome.json text eol=lf
