{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-leca.internal/schemas/prototype-v2.schema.json",
  "title": "PrototypeDefinitionV2",
  "description": "Contrato formal canônico para protótipos semânticos multiframework (v2.0.0).",
  "type": "object",
  "required": ["metadata", "screens"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "schemaVersion", "title", "designSystemId", "defaultScreenId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "schemaVersion": { "type": "string", "enum": ["2.0.0"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "designSystemId": { "type": "string" },
        "defaultScreenId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "screens": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title", "rootNodeId", "nodes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "route": { "type": "string" },
          "htmlFile": { "type": "string" },
          "rootNodeId": { "type": "string" },
          "initialState": { "type": "object" },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/PrototypeNode"
            }
          }
        }
      }
    },
    "globalState": { "type": "object" },
    "assets": {
      "type": "object",
      "properties": {
        "css": { "type": "array", "items": { "type": "string" } },
        "js": { "type": "array", "items": { "type": "string" } },
        "fonts": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "PrototypeNode": {
      "type": "object",
      "required": ["id", "componentId", "props"],
      "properties": {
        "id": { "type": "string" },
        "componentId": { "type": "string" },
        "componentVersion": { "type": "string" },
        "label": { "type": "string" },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["propName", "stateKey"],
            "properties": {
              "propName": { "type": "string" },
              "stateKey": { "type": "string" },
              "transform": { "type": "string" }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["navigate", "setState", "openModal", "emit"] },
              "target": { "type": "string" },
              "payload": { "type": "object" }
            }
          }
        },
        "slotTargets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "children": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
