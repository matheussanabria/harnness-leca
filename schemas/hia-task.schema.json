{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-leca.internal/schemas/hia-task.schema.json",
  "title": "HiaTaskDefinition",
  "description": "Contrato canônico de tarefa (Task) para o Harness Intelligence & Automation (HIA).",
  "type": "object",
  "required": ["id", "type", "title", "project", "routing", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": ["deterministic", "semantic_simple", "semantic_complex", "interactive_chat", "background_batch"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "storyId": {
      "type": ["string", "null"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "default": "P1"
    },
    "routing": {
      "type": "object",
      "required": ["preferredEngine", "fallbackPolicy"],
      "properties": {
        "preferredEngine": {
          "type": "string",
          "enum": ["script", "local_llm", "cloud_claude", "cloud_codex", "cloud_gemini", "cloud_opencode"]
        },
        "targetToolId": {
          "type": ["string", "null"]
        },
        "targetModelId": {
          "type": ["string", "null"]
        },
        "fallbackPolicy": {
          "type": "string",
          "enum": ["fail_fast", "prompt_user", "fallback_local", "fallback_cloud_authorized"],
          "default": "prompt_user"
        },
        "maxBudgetTokens": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memoryScope": {
          "type": "string",
          "enum": ["none", "minimal", "project_only", "full"],
          "default": "minimal"
        },
        "instructionScope": {
          "type": "string",
          "enum": ["none", "minimal", "project_only", "full"],
          "default": "minimal"
        },
        "daiAgent": {
          "type": ["string", "null"]
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "createdAt": {
      "type": "string"
    }
  }
}
