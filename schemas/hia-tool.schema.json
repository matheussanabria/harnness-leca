{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-leca.internal/schemas/hia-tool.schema.json",
  "title": "HiaToolDefinition",
  "description": "Contrato canônico do Automation Registry para ferramentas e scripts determinísticos do Harness.",
  "type": "object",
  "required": ["id", "name", "category", "entrypoint", "permissions", "timeoutMs"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["git", "ast_analysis", "indexing", "testing", "formatting", "synchronization", "diagnostics"]
    },
    "entrypoint": {
      "type": "string",
      "description": "Caminho relativo do script (ex: tools/sync.js ou tools/lib/classify.js)"
    },
    "isDeterministic": {
      "type": "boolean",
      "default": true
    },
    "isDestructive": {
      "type": "boolean",
      "default": false
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "default": 30000
    },
    "permissions": {
      "type": "object",
      "required": ["filesystem", "network"],
      "properties": {
        "filesystem": {
          "type": "string",
          "enum": ["none", "read_only", "read_write_isolated", "read_write_project"]
        },
        "network": {
          "type": "string",
          "enum": ["none", "local_only", "external"]
        },
        "allowExecution": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "inputSchema": {
      "type": "object",
      "description": "JSON Schema dos argumentos de entrada aceitos pelo script."
    },
    "outputSchema": {
      "type": "object",
      "description": "JSON Schema do resultado estruturado devolvido."
    }
  }
}
